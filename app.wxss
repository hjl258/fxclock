page {
  background: #eef1f7;
  color: #1b1f2a;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.page {
  position: relative;
  min-height: 100vh;
}

/* 背景：柔和径向渐变 + 斜向光带 */
.bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background:
    radial-gradient(52% 38% at 84% 58%, rgba(118, 226, 212, 0.40) 0%, rgba(118, 226, 212, 0) 70%),
    radial-gradient(44% 30% at 4% 60%, rgba(246, 192, 212, 0.50) 0%, rgba(246, 192, 212, 0) 72%),
    radial-gradient(70% 34% at 52% 100%, rgba(176, 202, 255, 0.55) 0%, rgba(176, 202, 255, 0) 72%),
    linear-gradient(180deg, #f3f5fa 0%, #e9edf6 52%, #e5eaf5 100%);
}

.bg-band {
  position: fixed;
  left: -30%;
  top: 30%;
  width: 160%;
  height: 34%;
  z-index: 0;
  transform: rotate(-9deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 48%, rgba(255, 255, 255, 0) 100%);
}

.page-body {
  position: relative;
  z-index: 1;
  padding-bottom: 220rpx;
}

/* 自定义导航栏 */
.nav {
  position: relative;
  z-index: 2;
  box-sizing: content-box;
}

.nav-row {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 24rpx 0 32rpx;
}

.nav-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #16181f;
  letter-spacing: 1rpx;
}

.nav-gap {
  flex: 1;
}



.tap {
  opacity: 0.7;
}

/* 通用卡片 */
.card-skin {
  background: linear-gradient(150deg, #eef6fe 0%, #e9f0fd 58%, #eaf1fb 100%);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 150, 200, 0.10);
}

/* 主按钮 */
.primary-btn {
  margin: 16rpx 28rpx 0;
  height: 104rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #5aa9f8 0%, #3b7ff0 56%, #2f6ff0 100%);
  box-shadow: 0 14rpx 30rpx rgba(59, 127, 240, 0.32);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 分段控件 */
.seg {
  display: flex;
  align-items: center;
  background: #eef1f8;
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg-item {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #5a6478;
  border-radius: 12rpx;
}

.seg-on {
  background: #ffffff;
  color: #2f6fd0;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(140, 160, 200, 0.20);
}

.seg-lg .seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
}

/* 行设置 */
.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(150, 165, 200, 0.16);
}

.row-item:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #2c3140;
}

.row-value {
  font-size: 26rpx;
  color: #8b93a7;
}

.switch-s {
  transform: scale(0.78);
}

/* 底部弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 24, 38, 0.34);
  /* 必须高于自定义 TabBar(z-index 60)，否则弹层会被底栏压住 */
  z-index: 300;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 301;
  background: #ffffff;
  border-radius: 34rpx 34rpx 0 0;
  /* 只留左右内边距：上下留白挪进标题栏/滚动区，否则弹层边缘会出现
     既不能滚、又会把触摸放给页面的死区 */
  padding: 0 32rpx;
  box-shadow: 0 -12rpx 40rpx rgba(30, 45, 80, 0.18);
  max-height: 78vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 滚动交给里面的 scroll-view，页面本身不再滚 */
}

/* 弹层主体：撑满剩余高度，自身可滚
   （真机的滚动由 <scroll-view scroll-y> 处理，overflow 是给网页预览兜底的） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  padding-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #16181f;
}

.sheet-close {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.sheet-group {
  margin-top: 26rpx;
}

.sheet-group-title {
  font-size: 24rpx;
  color: #8b93a7;
  letter-spacing: 1rpx;
}

.radio-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  border-bottom: 1rpx solid rgba(150, 165, 200, 0.14);
}

.radio-row:last-child {
  border-bottom: none;
}

.radio-label {
  font-size: 28rpx;
  color: #2c3140;
}

.radio-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 页面级标题 */
.section-title {
  display: flex;
  align-items: baseline;
  margin: 26rpx 32rpx 0;
}

.section-title-main {
  font-size: 34rpx;
  font-weight: 700;
  color: #16181f;
}

.section-title-sub {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #8b93a7;
}

.mono {
  font-family: "DIN Alternate", "SF Pro Display", "Helvetica Neue", -apple-system, sans-serif;
  font-variant-numeric: tabular-nums;
}