.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #16181f;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 16rpx rgba(140, 160, 200, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.help-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 16rpx rgba(140, 160, 200, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-sym {
  font-size: 32rpx;
  font-weight: 700;
  color: #5a6478;
}

.section-title {
  margin: 26rpx 32rpx 12rpx;
  font-size: 28rpx;
  color: #2c3140;
}

/* 手动微调 */
.stepper-card {
  margin: 0 28rpx;
  padding: 22rpx 22rpx 22rpx 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 26rpx rgba(120, 150, 200, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-left {
  display: flex;
  flex-direction: column;
}

.stepper-title {
  font-size: 30rpx;
  color: #2c3140;
}

.stepper-value {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #98a0b3;
}

.stepper {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-radius: 32rpx;
  background: #eef1f8;
}

.step-btn {
  width: 92rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-sym {
  font-size: 38rpx;
  color: #2c3140;
}

.step-div {
  width: 1rpx;
  height: 34rpx;
  background: rgba(150, 165, 200, 0.5);
}

/* 时间源网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 18rpx;
}

.src-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 22rpx rgba(120, 150, 200, 0.10);
  border: 2rpx solid transparent;
}

.src-active {
  background: linear-gradient(150deg, #eef6ff 0%, #e3eefd 100%);
  border-color: #7fb4f5;
  box-shadow: 0 12rpx 26rpx rgba(90, 150, 240, 0.22);
}

.src-head {
  display: flex;
  align-items: center;
}

.src-badge {
  flex: none;
  min-width: 46rpx;
  height: 46rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.src-badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
}

.src-name {
  flex: 1;
  margin-left: 14rpx;
  font-size: 27rpx;
  color: #1b1f2a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.src-sync {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.src-sync-icon {
  width: 34rpx;
  height: 34rpx;
}

.src-time {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1f2a;
}

.src-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.src-add {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  border: 2rpx dashed rgba(140, 160, 200, 0.42);
  background: rgba(255, 255, 255, 0.5);
}

.add-sym {
  font-size: 52rpx;
  color: #b7c3d6;
}

/* 底部同步状态 */
.status-bar {
  display: flex;
  align-items: center;
  margin: 30rpx 22rpx 0;
  padding: 18rpx 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 28rpx rgba(120, 150, 200, 0.12);
}

.status-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-right {
  border-radius: 20rpx;
  padding: 12rpx 6rpx;
  background: rgba(255, 236, 232, 0.9);
}

.status-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e23c3c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.status-badge-text {
  font-size: 15rpx;
  line-height: 1.1;
  color: #ffffff;
  font-weight: 700;
}

.status-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #2c3140;
}

.status-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #98a0b3;
}

.status-mid {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.status-arrow {
  font-size: 30rpx;
  color: #c2ccdb;
}

.status-check {
  width: 34rpx;
  height: 34rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: #2fbf5b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-sym {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 700;
}

.status-text {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #2c3140;
}

.status-icon {
  width: 34rpx;
  height: 34rpx;
}

.status-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1b1f2a;
}

.page-body {
  padding-bottom: 60rpx;
}