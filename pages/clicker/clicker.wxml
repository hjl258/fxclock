<!-- 弹层打开时锁住页面滚动：比在弹层上 catchtouchmove 干净，也不会挡住内层滚动 -->
<page-meta page-style="{{pageStyle}}"></page-meta>
<view class="page">
  <view class="bg"></view>
  <view class="bg-band"></view>

  <view class="nav" style="padding-top:{{statusBarHeight}}px;height:{{navBarHeight}}px;">
    <view class="nav-row" style="padding-right:{{capsulePad}}px;">
      <text class="nav-title">定时点击</text>
      <view class="nav-gap"></view>
      <view class="add-btn" bindtap="openAdd" hover-class="tap">
        <text class="add-sym">＋</text>
        <text class="add-text">新建</text>
      </view>
    </view>
  </view>

  <view class="page-body">
    <!-- 生效状态：跟随「开启悬浮窗」 -->
    <view class="float-bar {{floatOn ? 'float-bar-on' : ''}}">
      <view class="float-bar-left">
        <view class="float-dot"></view>
        <text class="float-bar-text">{{floatOn ? '悬浮窗已开启 · 定时点击生效中' : '悬浮窗未开启 · 定时点击不会生效'}}</text>
      </view>
    </view>

    <view class="task-row" wx:for="{{list}}" wx:key="id">
      <view class="task-delete" data-id="{{item.id}}" bindtap="removeTaskById" hover-class="tap">删除</view>
      <view
        class="task-card {{swipeId === item.id ? 'task-open' : ''}} {{floatOn ? '' : 'card-muted'}}"
        data-id="{{item.id}}"
        bindtouchstart="onRowTouchStart"
        bindtouchend="onRowTouchEnd"
        bindtouchcancel="onRowTouchCancel"
        hover-class="none"
      >
        <view class="task-left">
          <view class="task-time">
            <view class="task-time-text">
              <text class="task-time-main mono">{{item.hms}}</text>
              <text class="task-time-ms mono">.{{item.ms}}</text>
            </view>
            <text class="task-place">{{item.placeX}}</text>
          </view>
          <view class="task-sub">
            <view class="task-sub-text">
              <text class="task-name">{{item.name}}</text>
              <text class="task-repeat">{{item.repeatLabel}}</text>
            </view>
            <text class="task-place">{{item.placeY}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length}}">
      <text class="empty-title">还没有定时任务</text>
      <text class="empty-sub">点右上角「＋ 新建」添加</text>
    </view>
  </view>

  <!-- 编辑 / 新建弹层
       防穿透由 page-meta 锁页面滚动 + 遮罩/标题栏上的 catchtouchmove 负责；
       弹层本体不能挂 catchtouchmove，否则真机上里面的 scroll-view 会滚不动 -->
  <view class="mask" wx:if="{{editing}}" bindtap="closeEdit" catchtouchmove="noop"></view>
  <view class="sheet" wx:if="{{editing}}">
    <view class="sheet-head" catchtouchmove="noop">
      <text class="sheet-title">{{form.id ? '编辑定时点击' : '新建定时点击'}}</text>
      <image class="sheet-close" src="{{icons.close}}" mode="aspectFit" bindtap="closeEdit"></image>
    </view>

    <!-- 内容放进 scroll-view：弹层自己滚，不会带动页面 -->
    <scroll-view class="sheet-body" scroll-y>
    <view class="time-preview">
      <text class="time-main mono">{{units[0].value}}:{{units[1].value}}:{{units[2].value}}</text>
      <text class="time-ms mono">.{{units[3].value}}</text>
    </view>

    <view class="stepper-row" wx:for="{{units}}" wx:key="key">
      <text class="stepper-label">{{item.label}}</text>
      <view class="stepper">
        <view class="step-btn" data-key="{{item.key}}" data-delta="-1" bindtap="stepUnit" hover-class="tap">−</view>
        <text class="step-value mono">{{item.value}}</text>
        <view class="step-btn" data-key="{{item.key}}" data-delta="1" bindtap="stepUnit" hover-class="tap">+</view>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">名称</text>
      <input class="form-input" value="{{form.name}}" placeholder="first / 闹钟" placeholder-class="ph" bindinput="onNameInput" />
    </view>

    <view class="form-row">
      <text class="form-label">重复</text>
      <view class="seg">
        <view class="seg-item {{form.repeat === 'daily' ? 'seg-on' : ''}}" data-repeat="daily" bindtap="setRepeat">每天</view>
        <view class="seg-item {{form.repeat === 'once' ? 'seg-on' : ''}}" data-repeat="once" bindtap="setRepeat">仅一次</view>
      </view>
    </view>

    <!-- 位置：设置项先预留 -->
    <view class="form-row">
      <text class="form-label">位置</text>
      <view class="place-value">
        <text class="place-text {{hasPlace ? 'place-on' : ''}}">{{placeText}}</text>
        <text class="place-tag" wx:if="{{hasPlace}}" bindtap="clearPlace" hover-class="tap">清除</text>
      </view>
    </view>

    <!-- 坐标系：点面板取点，或全屏取点 -->
    <view class="coord-wrap">
      <view class="coord-head">
        <text class="coord-title">坐标系</text>
        <text class="coord-hint">单位 px，原点在左上角</text>
      </view>
      <view class="coord-panel" bindtap="onPanelTap">
        <view class="coord-axis coord-axis-x"></view>
        <view class="coord-axis coord-axis-y"></view>
        <view class="coord-marker" wx:if="{{hasPlace}}" style="left:{{markerX}}%;top:{{markerY}}%">
          <view class="coord-marker-dot"></view>
        </view>
        <text class="coord-corner coord-tl">0,0</text>
        <text class="coord-corner coord-br">{{screenText}}</text>
      </view>
      <view class="pick-btn" bindtap="enterPick" hover-class="tap">全屏取点</view>
    </view>

    <view class="sheet-actions">
      <view class="danger-btn" wx:if="{{form.id}}" bindtap="removeTask" hover-class="tap">删除</view>
      <view class="primary-btn sheet-btn" bindtap="save" hover-class="tap">保存</view>
    </view>
    </scroll-view>
  </view>

  <view class="pick-mask" wx:if="{{pickMode}}" bindtap="onPick" catchtouchmove="noop">
    <text class="pick-tip">点击屏幕任意位置取点</text>
    <text class="pick-sub">坐标以屏幕左上角为原点（单位 px）</text>
    <view class="pick-cancel" catchtap="exitPick" hover-class="tap">取消</view>
  </view>

  <float-clock
    show="{{floatOn}}"
    source="{{floatSource}}"
    server-offset="{{floatOffset}}"
    label="{{floatLabel}}"
  />
</view>