.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 弹层打开时整体隐藏（含安全区内边距） */
.tabbar-hide {
  display: none;
}

.tabbar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 124rpx;
  border-radius: 62rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 34rpx rgba(120, 140, 180, 0.22);
  padding: 0 10rpx;
}

.tab-item {
  flex: 1 1 0;
  max-width: 220rpx;
  height: 100rpx;
  margin: 0 6rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-on {
  background: linear-gradient(180deg, #e8f1ff 0%, #dfeafd 100%);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2c3140;
  white-space: nowrap;
}

.tab-on .tab-text {
  color: #2f6fd0;
  font-weight: 600;
}