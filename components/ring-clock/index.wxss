/* 环形时钟：纯 DOM + SVG（尺寸基准 500rpx，与 utils/ringSvg.js 的 500 单位一一对应） */
.ring {
  position: relative;
}

/* 外盘：渐变底 + 投影（原 canvas 第 1 步） */
.ring-face {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffffff 0%, #fbfcfe 45%, #e8ecf5 100%);
  box-shadow: 0 14rpx 42rpx rgba(118, 136, 178, 0.30);
}

/* 内盘：径向渐变（原 canvas 第 2 步） */
.ring-face-inner {
  position: absolute;
  left: 33.5rpx;
  top: 33.5rpx;
  right: 33.5rpx;
  bottom: 33.5rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 28%, #ffffff 0%, #f7f8fc 72%, #eef1f8 100%);
}

/* 内外盘之间的高光分隔线（原 canvas 第 3 步） */
.ring-face-line {
  position: absolute;
  left: 21rpx;
  top: 21rpx;
  right: 21rpx;
  bottom: 21rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}

/* 刻度 + 四色定位点（静态 SVG，只算一次） */
.ring-ticks,
.ring-arc {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 中央内容必须压在所有图形之上 */
.ring-center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #f2f4ff 0%, #e9ecfb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.ring-badge-icon {
  width: 50rpx;
  height: 50rpx;
}

.ring-time {
  font-size: 72rpx;
  font-weight: 700;
  color: #1b1f2a;
  letter-spacing: 1rpx;
  line-height: 1;
}

.ring-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #98a0b3;
  letter-spacing: 1rpx;
}
